{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  // Rebase whenever the branch falls behind main. The default only rebases
  // automerge candidates, so a PR a human merges would sit on a stale main and
  // report CI results from a workflow that no longer exists there.
  "rebaseWhen": "behind-base-branch",


  // No aqua preset: this repo has no aqua.yaml. The tools it pins are the ones it
  // bakes into the images, not ones it runs in CI.
  "extends": [
    // config:best-practices = config:recommended + docker:pinDigests
    // + helpers:pinGitHubActionDigests + :configMigration + :pinDevDependencies
    // + abandonments:recommended + security:minimumReleaseAgeNpm
    // + :maintainLockFilesWeekly. The two presets listed separately before are
    // both inside it now.
    "config:best-practices"
  ],

  // These images are rebuilt and pushed on merge, and every cluster workload that
  // uses one is digest-pinned against it. Batch the churn into one weekly PR
  // rather than rebuilding on each upstream release.
  "schedule": ["before 9am on Monday"],
  "timezone": "Asia/Tokyo",

  "minimumReleaseAge": "3 days",

  // Merge directly rather than queueing on GitHub: this repo has no required
  // checks that platform automerge would wait on.
  "platformAutomerge": false,

  "customManagers": [
    {
      "description": [
        "One annotation-driven manager for every tool baked into the Dockerfiles.",
        "This replaced nine near-identical per-tool managers. That duplication was",
        "not just verbose: two of the nine had double-escaped regexes (\\\\S+ instead",
        "of \\\\S+, which matches a literal backslash), so crane and",
        "container-structure-test silently matched nothing and went unmaintained.",
        "Four more tools — helm, logcli, cosign, argocd — had no manager at all.",
        "With the datasource next to the pin it maintains, adding an ARG without",
        "maintaining it is visible in the diff instead of invisible in this file.",
        "extractVersion is a capture group rather than a template because jq tags",
        "its releases jq-1.8.2 while everything else uses a leading v."
      ],
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) extractVersion=(?<extractVersion>\\S+)\\s*\\nARG \\w+_VERSION=(?<currentValue>\\S+)"
      ]
    }
  ],

  "packageRules": [
    {
      "description": [
        "The Spin CLI is capped by the cluster nodes: containerd-shim-spin links an",
        "older Spin, and a newer CLI builds and runs components the nodes refuse.",
        "home-rss's e2e refuses any CLI other than its release's, so the image has",
        "to carry the same one. Lift this when the shim ships a newer Spin."
      ],
      "matchPackageNames": ["spinframework/spin"],
      "matchUpdateTypes": ["major", "minor"],
      "dependencyDashboardApproval": true
    },
    {
      "description": [
        "DBMATE_SHA256 in the Dockerfile isn't tracked by the customManager —",
        "only DBMATE_VERSION is. dbmate's releases don't publish a checksum, so",
        "the hash has to be updated by hand alongside the version; an automerged",
        "version bump alone leaves the hash mismatched and the build fails.",
        "Held for every update, not just major/minor, since minor/patch would",
        "otherwise fall into the automerged 'all non-major updates' group below."
      ],
      "matchPackageNames": ["amacneil/dbmate"],
      "dependencyDashboardApproval": true
    },
    {
      "description": [
        "First-party code does not soak. minimumReleaseAge buys time for someone",
        "else to notice a poisoned release before we take it; there is no someone",
        "else here — we wrote it, reviewed it and merged it. Waiting three days on",
        "our own reusable workflow only delays fixes to the thing that gates every",
        "other check."
      ],
      "matchPackageNames": ["Tsuguya-HC/**"],
      "minimumReleaseAge": "0"
    },
    {
      // One PR for the whole weekly refresh. Each image is rebuilt as a unit
      // anyway, so splitting the bumps only multiplies the builds.
      "description": "Group all patch and minor updates into a single PR",
      "matchUpdateTypes": ["patch", "minor", "digest"],
      "groupName": "all non-major updates",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": [
        "Docker digest age gate is unenforceable (renovate#38656); the",
        "digest-cooldown workflow gates these instead."
      ],
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["digest", "pinDigest"],
      "minimumReleaseAge": "0"
    }
  ]
}
